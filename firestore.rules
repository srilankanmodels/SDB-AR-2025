rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    // Bootstrapped Admin using runtime metadata credentials
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'srilankanmodels@gmail.com' && request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Context-Aware Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Specific Entity Validators
    function isValidBranding(data) {
      return data.logoColor is string && data.logoColor.size() <= 15
        && (data.logoTextSDB is string && data.logoTextSDB.size() <= 100)
        && (data.logoTextBank is string && data.logoTextBank.size() <= 100)
        && (data.logoTextColorBank is string && data.logoTextColorBank.size() <= 15)
        && (data.headOfficeImage is string && data.headOfficeImage.size() <= 2000)
        && (data.cooperativeFarmingImage is string && data.cooperativeFarmingImage.size() <= 2000)
        && (data.digitalBankingImage is string && data.digitalBankingImage.size() <= 2000)
        && (data.boardroomLeadershipImage is string && data.boardroomLeadershipImage.size() <= 2000)
        && (data.logoImage is string && data.logoImage.size() <= 2000)
        && (data.coverImage is string && data.coverImage.size() <= 2000)
        && (data.chairpersonImage is string && data.chairpersonImage.size() <= 2000)
        && (data.ceoImage is string && data.ceoImage.size() <= 2000);
    }

    function isValidFeedback(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.sectionId is string && data.sectionId.size() <= 100
        && data.comment is string && data.comment.size() <= 5000
        && (data.rating is number && data.rating >= 1 && data.rating <= 5);
    }

    function isValidBookmark(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.sectionId is string && data.sectionId.size() <= 100
        && (data.personalNotes is string && data.personalNotes.size() <= 10000);
    }

    function isValidChat(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.messages is list && data.messages.size() <= 100;
    }

    // 2. Branding Config Collection Rules
    match /branding/{docId} {
      allow read: if true; // Any visitor can read the visual theme config
      allow create, update: if isAdmin() && isValidBranding(incoming());
      allow delete: if isAdmin();
    }

    // 3. Strategic Feedback Collection Rules
    match /feedback/{feedbackId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin(); // Only admins can aggregate or browse all reviews
      allow create: if isVerifiedUser() && isValidFeedback(incoming()) && (incoming().userId == 'anonymous' || incoming().userId == request.auth.uid);
      allow update, delete: if false; // Append-only strategic feedback
    }

    // 4. Report Bookmarks Collection Rules
    match /bookmarks/{bookmarkId} {
      allow get, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid; // Enforces secure client queries
      allow create: if isVerifiedUser() && isValidBookmark(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidBookmark(incoming()) 
        && incoming().userId == request.auth.uid 
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['personalNotes', 'noteNumber', 'noteTitle']);
    }

    // 5. Chat History Collection Rules
    match /chats/{chatId} {
      allow get, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid; // Enforces secure client queries
      allow create: if isVerifiedUser() && isValidChat(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidChat(incoming())
        && incoming().userId == request.auth.uid
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'title', 'updatedAt']);
    }
  }
}
